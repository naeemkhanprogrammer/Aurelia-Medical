# ─────────────────────────────────────────────────────────────
# Aurelia Medical Group — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Canonical public URL of the site (used for canonical links, sitemap, OG tags, JSON-LD).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags (server-side). "true" / "false". Defaults live in src/config/features.ts.
# Testimonials are subject to CPSA advertising rules — confirm with the clinic before enabling in production.
FEATURE_TESTIMONIALS=true
FEATURE_STATS=true
FEATURE_MAP_EMBED=true
